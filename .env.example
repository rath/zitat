WHISPER_BIN=~/path/to/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=~/path/to/whisper.cpp/models/ggml-large-v3-turbo.bin

# 자막 분할 (모두 선택 사항, CLI 옵션이 우선)
# ZITAT_MAX_WIDTH=30          # 큐 최대 표시 칸 (한글 1자 = 2칸)
# ZITAT_MIN_CUE_MS=800        # 큐 최소 표시 시간 (ms)
# ZITAT_PAUSE_GAP_MS=400      # 이 이상 벌어지면 원문 큐를 나눔 (ms)
# ZITAT_MAX_CUE_MS=5000       # 원문 큐 최대 길이 (ms)
# ZITAT_BRIDGE_GAP_MS=1500    # 이 이하의 간격은 메움 (ms)
# ZITAT_TRANSLATE_BATCH=80    # claude 호출당 큐 수

# whisper
# ZITAT_DTW=large.v3.turbo    # 미지정 시 모델 파일명에서 자동 유도
# ZITAT_WHISPER_MAX_LEN=0     # whisper -ml (0이면 비활성)

# 자막 스타일
# ZITAT_FONT=BM Dohyeon
# ZITAT_FONT_SIZE=22
# ZITAT_STYLE=MarginV=40,Bold=1
